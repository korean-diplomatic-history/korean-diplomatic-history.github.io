{% import "_material.html.j2" as M %}
{% macro timeline(rows, era_labels, show_era=True) %}
<div class="timeline">
  {% set ns = namespace(year='') %}
  {% for s in rows %}
  {% if s.year != ns.year %}
  {% set ns.year = s.year %}
  <div class="year-rule"><span class="y">{{ s.year }}</span><span class="r"></span></div>
  {% endif %}
  <div class="timeline-item"{% if s.get('era_anchor') %} id="era-{{ s.era_anchor }}"{% endif %}>
    <div class="timeline-date">{{ s.date_display }}{% if s.venue %} · {{ s.venue }}{% endif %}</div>
    <div class="timeline-title">
      {% if show_era %}<span class="timeline-badge badge-{{ s.era }}">{{ era_labels[s.era] }}</span>{% endif %}
      <a href="{{ s.url }}">{{ s.session_label }}</a>
      {% if s.status and s.status != '개최' %}<span class="status">{{ s.status }}</span>{% endif %}
    </div>
    {% if s.topic %}<div class="timeline-topic">{{ s.topic }}</div>{% endif %}
    <div class="tl-body">{{ M.body(s, '', 'h3') }}</div>
    {% if s.record %}<div class="timeline-tags"><a class="tag rec" href="{{ s.url }}">모임 기록 읽기</a></div>{% endif %}
  </div>
  {% endfor %}
</div>
{% endmacro %}
