{% extends "base.html.j2" %}
{% import "_timeline.html.j2" as tl %}
{% block title %}{{ sessions.past.title }} — {{ site.title }}{% endblock %}
{% block description %}{{ sessions.past.meta_description }}{% endblock %}

{% block hero %}
<div class="hero page">
  <h1>{{ sessions.past.title }}</h1>
  <p class="subtitle">{{ sessions.past.kicker }}</p>
</div>
{% endblock %}

{% block content %}
<section class="band">
  <div class="container">
    <div class="era-grid">
      {% for era in past_eras %}
      <a class="era-card" href="{{ era.href }}">
        <div class="era-range">{{ era.range }}</div>
        <h3>{{ era.label }}</h3>
        <p>{{ era.note }}</p>
        <div class="era-count">{{ era.count }}회</div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section>
  <div class="container">
    {{ tl.timeline(past, sessions.era_labels) }}
  </div>
</section>
{% endblock %}
