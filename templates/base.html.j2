<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ site.title }}{% endblock %}</title>
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<meta name="description" content="{% block description %}{{ site.meta_description }}{% endblock %}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:url" content="{{ base_url }}/{{ page_file }}">
<meta property="og:locale" content="ko_KR">
<link rel="canonical" href="{{ base_url }}/{{ page_file }}">
<link rel="icon" href="{{ prefix }}favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ font_href }}">
<link rel="stylesheet" href="{{ prefix }}style.css">
</head>
<body>
<a class="skip" href="#main">본문으로 건너뛰기</a>

<header>
  <div class="header-inner">
    <div class="site-title">
      <a href="{{ prefix }}index.html">
        <span class="mark">{{ site.title }}</span>
        <span class="mark-sub">{{ site.title_sub }}</span>
      </a>
    </div>
    <nav class="main" aria-label="주 메뉴">
      {% for slug, filename, navkey in pages %}
      <a href="{{ prefix }}{{ filename }}"{% if page == navkey %} class="active" aria-current="page"{% endif %}>{{ site.nav[navkey] }}</a>
      {% endfor %}
    </nav>
  </div>
</header>

{% block hero %}{% endblock %}

<main id="main">
{% block content %}{% endblock %}
</main>

<footer>
  <div class="foot-nav">
    {% for slug, filename, navkey in pages %}
    <a href="{{ prefix }}{{ filename }}">{{ site.nav[navkey] }}</a>
    {% endfor %}
  </div>
  <div>{{ site.footer.line }}</div>
  <div class="foot-legal">{{ site.footer.legal|safe }}</div>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
